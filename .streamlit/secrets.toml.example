# MODELO — copie este arquivo para `.streamlit/secrets.toml` e preencha com os
# dados reais do banco. O `secrets.toml` (sem .example) está no .gitignore e
# NUNCA deve ser versionado, porque contém a senha.
#
# Formato da URL de conexão:
#   postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Exemplos:
#   Local:      postgresql://postgres:senha@localhost:5432/vaguinha
#   Supabase/Neon (exigem SSL): acrescente ?sslmode=require no final
#               postgresql://user:senha@host:5432/vaguinha?sslmode=require

DATABASE_URL = "postgresql://usuario:senha@host:5432/nome_do_banco"

# Só no app de TESTE (branch develop): mostra a faixa "AMBIENTE DE TESTE".
# No app de produção, remova esta linha ou use "producao".
AMBIENTE = "teste"
